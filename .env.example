# Use MOCK to run without calling ASAAS
ASAAS_API_KEY=MOCK

# Token used to validate ASAAS webhook requests in the Proxy
ASAAS_WEBHOOK_TOKEN=webhook-secret

# Token used by the Proxy to notify the Manager (can be the same token)
WEBHOOK_TOKEN=webhook-secret

# Optional SMTP (leave empty to log EMAIL-MOCK in Manager)
MAIL_HOST=
MAIL_PORT=25
MAIL_USER=
MAIL_PASS=
